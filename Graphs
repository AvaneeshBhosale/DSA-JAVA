import java.util.*;

class Solution {

    // Q3: Find minimum time required to rot all oranges

    static int R = 3;
    static int C = 5;

    static class Ele {
        int x, y;

        Ele(int x, int y) {
            this.x = x;
            this.y = y;
        }
    }

    static boolean isValid(int i, int j) {
        return i >= 0 && j >= 0 && i < R && j < C;
    }

    static int rottenOranges(int[][] arr) {

        Queue<Ele> q = new LinkedList<>();
        int fresh = 0;
        int time = 0;

        // Add all rotten oranges initially
        for (int i = 0; i < R; i++) {
            for (int j = 0; j < C; j++) {

                if (arr[i][j] == 2)
                    q.add(new Ele(i, j));

                else if (arr[i][j] == 1)
                    fresh++;
            }
        }

        // Four possible directions
        int[] dx = {-1, 1, 0, 0};
        int[] dy = {0, 0, -1, 1};

        while (!q.isEmpty() && fresh > 0) {

            int size = q.size();

            // Process one level at a time
            for (int i = 0; i < size; i++) {

                Ele temp = q.poll();

                for (int k = 0; k < 4; k++) {

                    int nx = temp.x + dx[k];
                    int ny = temp.y + dy[k];

                    if (isValid(nx, ny) && arr[nx][ny] == 1) {

                        arr[nx][ny] = 2;
                        fresh--;

                        q.add(new Ele(nx, ny));
                    }
                }
            }

            time++;
        }

        // Fresh oranges still remaining
        if (fresh > 0)
            return -1;

        return time;
    }

    public static void main(String[] args) {

        int[][] arr = {
            {2, 1, 0, 2, 1},
            {1, 0, 1, 2, 1},
            {1, 0, 0, 2, 1}
        };

        int ans = rottenOranges(arr);

        if (ans == -1)
            System.out.println("All oranges cannot rot");
        else
            System.out.println(
                "Time required for all oranges to rot = " + ans
            );
    }
}


